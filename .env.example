# 복사해서 .env 로 저장 후 값 입력 (.env 는 절대 커밋/공유 금지)
HOST=127.0.0.1
PORT=8080
# guest = 인증 없이 바로 사용, email = @kangwon.ac.kr 인증코드 로그인
LOGIN_MODE=guest
ALLOWED_EMAIL_DOMAIN=kangwon.ac.kr
# HTTPS 운영 환경에서는 1
COOKIE_SECURE=0

# 네이버 뉴스 검색 API (ncp: NAVER API HUB / developers: 네이버 개발자센터)
NAVER_AUTH_TYPE=ncp
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 인증코드 메일 발송 SMTP. 비워두면 개발 모드(코드가 서버 콘솔에 출력됨)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
